---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: redirect-hml-catalogo-tcc
  namespace: kong
spec:
  parentRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: kong
      sectionName: http
  hostnames:
    - hml-catalogo.tcc.altasistemas.com.br
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      filters:
        - type: RequestRedirect
          requestRedirect:
            scheme: https
            hostname: hml-catalogo.tcc.altasistemas.com.br
            statusCode: 301
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: redirect-hml-catalogo-api-tcc
  namespace: kong
spec:
  parentRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: kong
      sectionName: http
  hostnames:
    - hml-catalogo-api.tcc.altasistemas.com.br
