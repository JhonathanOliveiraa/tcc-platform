# DESATIVADO: no KIC 3.5 + Kong 3.9 um RequestRedirect sem hostname vira plugin inválido e o Kong
# recusa a configuração inteira (mesma conclusão do norte-k3s, k8s/PADROES.md). Se voltar, precisa
# de requestRedirect.hostname explícito (uma rota por host) ou de Kong 3.10+.
# HTTP -> HTTPS (301) para os hosts atendidos pelo Gateway.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: redirect-https
  namespace: kong
spec:
  parentRefs:
    - name: kong
      sectionName: http
  hostnames:
    - argo.altasistemas.com.br
    - "*.tcc.altasistemas.com.br"
  rules:
    - filters:
        - type: RequestRedirect
          requestRedirect:
            scheme: https
            statusCode: 301
